  "license": "MIT",
  "author": "FileSeal (https://fileseal.uk)",
  "homepage": "https://fileseal.uk/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fileseal/mcp-send.git"
  },
  "bugs": {
    "url": "https://github.com/fileseal/mcp-send/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fileseal",
    "secure-send",
    "file-sharing",
    "encryption",
    "one-time-link",
    "gdpr"
  ],
  "type": "module",
  "bin": {
